# Machine-specific settings for the test-cycle scripts (push-gma500.sh) and the fork scripts.
# Copy to tools/bringup/local.env (gitignored) and edit. The file is sourced by bash;
# the ${VAR:-value} form lets a variable set in the environment still win.
# Unset variables fall back to the defaults listed in push-gma500.sh.

# ssh destinations; host aliases from ~/.ssh/config work as well. SGX_BUILD_HOST=target
# makes the laptop build the module itself (sgx-build), away from the build host.
SGX_BUILD_HOST=${SGX_BUILD_HOST:-sgx-build}
SGX_TARGET_HOST=${SGX_TARGET_HOST:-user@sgx-target}
# Extra ssh/scp options for the laptop, e.g. a host key alias when it dual-boots.
SGX_TARGET_SSH_OPTS=${SGX_TARGET_SSH_OPTS:-"-o HostKeyAlias=sgx-target"}

# Build host: kernel tree (relative to the remote $HOME), make -j, extra PATH entries
# (quoted, so ~ expands on the build host and not here).
SGX_KERNEL_TREE=${SGX_KERNEL_TREE:-src/linux-sgx}
SGX_KERNEL_RELEASE=${SGX_KERNEL_RELEASE:-7.3.0-sgx}
# The test kernel's package; a second test kernel gets its own (and its own release).
SGX_KERNEL_PKGBASE=${SGX_KERNEL_PKGBASE:-linux-sgx}
SGX_BUILD_JOBS=${SGX_BUILD_JOBS:-8}
SGX_BUILD_PATH=${SGX_BUILD_PATH:-'~/.local/bin'}
# The IGT clone on the build host (from its $HOME, or absolute), whose build32/ holds
# the IGT binaries push-tools.sh copies to the laptop.
SGX_IGT_TREE=${SGX_IGT_TREE:-/path/to/igt-gpu-tools}

# Delivering the module of a checked fork tip (tools/fork/deliver-module.sh; recheck.sh reads
# the clone too): the build host's clone of the fork and the delivery directory (from its
# $HOME), and the config of the laptop's installed test kernel there. Set
# SGX_KERNEL_RELEASE above to that kernel's release: the module's vermagic must be
# "<release> SMP preempt mod_unload 686". Traveling (the laptop as its own build host,
# FORK_CHECK_HOST the laptop, FORK_CHECK_RUNNER=chroot): start the delivery directory from a
# built O= directory of the same config (a full build there takes most of a day).
FORK_CHECK_CLONE=${FORK_CHECK_CLONE:-src/linux-sgx-check}
FORK_DELIVER_WORK=${FORK_DELIVER_WORK:-src/linux-sgx-deliver}
FORK_DELIVER_CONFIG=${FORK_DELIVER_CONFIG:-src/config-of-the-installed-test-kernel}
# FORK_DELIVER_SEED=${FORK_DELIVER_SEED:-src/linux-sgx-checkout-check/build-on}

# Where the laptop sends netconsole (an IPv4 address the laptop can reach).
SGX_NETCONSOLE_HOST=${SGX_NETCONSOLE_HOST:-192.0.2.10}
SGX_NETCONSOLE_PORT=${SGX_NETCONSOLE_PORT:-6666}

# Paths for the run scripts (health.sh, deploy-tool.sh, run-table.sh), the tools that read the
# data repositories and the guard. Placeholders: edit them in your local.env, never here.
# The data repositories sit beside this checkout by default.
RESGX545_DATA=${RESGX545_DATA:-../resgx545-data}
RESGX545_DATA_PRIVATE=${RESGX545_DATA_PRIVATE:-../resgx545-data-private}
# The firmware's microkernel as captured from a running driver (in the private data).
RESGX545_UKERNEL=${RESGX545_UKERNEL:-../resgx545-data-private/firmware/images/images/00_ukernel.bin}
# The prefix of the radare2 fork's install (the r2 plugins and scripts).
R2_PREFIX=${R2_PREFIX:-/path/to/radare2-prefix}
# The closed Cedarview userspace libraries' directory (black box: strings and exports only).
RESGX545_CDV_LIBS=${RESGX545_CDV_LIBS:-/path/to/closed/libraries}
# The clean-room guard's private directory (default: clean-room/ in the private data checkout).
RESGX545_GUARD_DIR=${RESGX545_GUARD_DIR:-../resgx545-data-private/clean-room}
